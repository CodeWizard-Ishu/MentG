generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              Int             @id @default(autoincrement())
  firstName       String   
  lastName        String?  
  email           String           @unique
  password        String   
  isMentor        Boolean   
  isActive        Boolean   

  // Relationships
  mentorProfile   MentorProfile?   @relation("UserMentorProfile")
  menteeProfile   MenteeProfile?   @relation("UserMenteeProfile")
}

model MentorProfile {
  id              Int             @id @default(autoincrement())
  userId          Int             @unique
  bio             String?
  profilePicture  String?         // URL for the profile picture
  services        Service[]       
  experience      String?
  rating          Float            @default(0) // Average rating calculated from ratings
  bookings        Booking[]        // Relationship to bookings

  totalEarnings   Float            @default(0) // Total earnings from bookings
  totalBookings   Int              @default(0) // Total number of bookings received
  uniqueMentees   Int              @default(0) // Number of unique mentees who have booked

  domains         Domain[]         @relation("MentorDomains")

  ratings         Rating[]         // Added relationship to ratings

  user            User             @relation("UserMentorProfile", fields: [userId], references: [id])
}

model MenteeProfile {
  id              Int             @id @default(autoincrement())
  userId          Int             @unique
  goals           String?

  profilePicture  String?         // URL for the profile picture

  domains         Domain[]         @relation("MenteeDomains")

  bookings        Booking[]        // Added relationship to bookings

  ratings         Rating[]         // Added relationship to ratings

  user            User             @relation("UserMenteeProfile", fields: [userId], references: [id])
}

model Service {
  id              Int             @id @default(autoincrement())
  name            String    
  description     String?   

  // Relationship
  mentorId        Int       
  mentor          MentorProfile    @relation(fields: [mentorId], references: [id])
}

model Booking {
  id              Int             @id @default(autoincrement())
  mentorId        Int
  menteeId        Int
  dateTime        DateTime
  duration        Int              // Duration in minutes
  payment         Float            // Payment amount
  status          BookingStatus

  // Relationships
  mentor          MentorProfile    @relation(fields: [mentorId], references: [id])
  mentee          MenteeProfile    @relation(fields: [menteeId], references: [id])
}

model Domain {
  id              Int             @id @default(autoincrement())
  name            String           @unique
  
  // Many-to-many relationship with MentorProfile and MenteeProfile
  mentors         MentorProfile[]   @relation("MentorDomains")
  
  mentees         MenteeProfile[]   @relation("MenteeDomains")
}

model Rating {
  id              Int             @id @default(autoincrement())
  mentorId        Int
  menteeId        Int
  score           Int               // Rating score (e.g., from a scale of 1-5)
  feedback        String?           // Optional feedback text
  createdAt       DateTime         @default(now())

  // Relationships
  mentor          MentorProfile    @relation(fields: [mentorId], references: [id])
  mentee          MenteeProfile    @relation(fields: [menteeId], references: [id])
}

enum BookingStatus {
    PENDING
    CONFIRMED
    COMPLETED
    CANCELED
}