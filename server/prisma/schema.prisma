generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int     @id @default(autoincrement())
  firstName String
  lastName  String?
  email     String  @unique
  password  String
  isMentor  Boolean
  isActive  Boolean

  // Relationships
  mentorProfile MentorProfile? @relation("UserMentorProfile")
  menteeProfile MenteeProfile? @relation("UserMenteeProfile")
  resetTokens ResetToken[] @relation("UserResetToken")
}

// Reset Token model
model ResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int      // Foreign key linking to User
  expiresAt DateTime
  createdAt DateTime @default(now())

  // Relationship
  user User @relation("UserResetToken", fields: [userId], references: [id])

  @@index([token]) // Index for faster token lookups
}

model MentorProfile {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  bio            String? // Brief biography of the mentor
  profilePicture String? // URL for the profile picture
  phoneNumber    String? // phone number of mentor
  services Service[] @relation("MentorServices") // Many-to-many relationship with Service
  experience     String? // Description of the mentor's experience
  rating         Float     @default(0) // Average rating calculated from ratings
  bookings       Booking[] // Relationship to bookings
  linkedin       String?
  twitter        String?
  instagram      String?
  totalEarnings  Float     @default(0) // Total earnings from bookings
  totalBookings  Int       @default(0) // Total number of bookings received
  uniqueMentees  Int       @default(0) // Number of unique mentees who have booked

  domains Domain[] @relation("MentorDomains") // Areas of expertise

  ratings Rating[] // Relationship to ratings given by mentees

  user User @relation("UserMentorProfile", fields: [userId], references: [id])

  availability Availability[] // Relationship to availability slots for bookings

  calendarConnections CalendarConnection[]  // Relationship to Calendar Connection
}

model MenteeProfile {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  goals          String? // Goals of the mentee
  phoneNumber    String? // phone number of mentee
  profilePicture String? // URL for the profile picture
  linkedin       String?
  twitter        String?
  instagram      String?
  bookings       Booking[] // Relationship to bookings

  ratings Rating[] // Relationship to ratings

  user User @relation("UserMenteeProfile", fields: [userId], references: [id])
}

model Service {
  id          Int     @id @default(autoincrement())
  name        String // Name of the service offered by the mentor
  description String? // Description of the service
  price       Float   @default(0) // Price for the service
  mentorId    Int? // Foreign key linking to MentorProfile

  mentor MentorProfile[] @relation("MentorServices") // Many-to-many relationship with MentorProfile
}

model Booking {
  id Int @id @default(autoincrement())

  mentorId Int // Foreign key linking to MentorProfile
  menteeId Int // Foreign key linking to MenteeProfile

  dateTime DateTime @db.Timestamptz // Date and time of the booking
  duration Int // Duration in minutes
  payment  Float // Payment amount
  status   BookingStatus // Status of the booking

  // Service details stored directly in Booking
  serviceName String // Name of the service offered
  serviceDescription String? // Description of the service
  servicePrice Float // Price for the service
  meetLink String? // Added field for Google Meet link

  // Relationships
  mentor MentorProfile @relation(fields: [mentorId], references: [id])
  mentee MenteeProfile @relation(fields: [menteeId], references: [id])
}

model CalendarConnection {
  id            Int          @id @default(autoincrement())
  mentorId      Int
  provider      String       // 'google' or 'outlook'
  accessToken   String
  refreshToken  String?
  expiresAt     DateTime
  email         String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  mentor        MentorProfile @relation(fields: [mentorId], references: [userId])

  @@unique([mentorId, provider])
  @@index([mentorId])
}

model Domain {
  id Int @id @default(autoincrement())

  name String @unique

  // Many-to-many relationship with MentorProfile and MenteeProfile
  mentors MentorProfile[] @relation("MentorDomains")
}

model Rating {
  id       Int @id @default(autoincrement())
  mentorId Int // Foreign key linking to MentorProfile
  menteeId Int // Foreign key linking to MenteeProfile

  score    Int // Rating score (must be between 1 and 5)
  feedback String? // Optional feedback text

  createdAt DateTime      @default(now())
  // Relationships
  mentor    MentorProfile @relation(fields: [mentorId], references: [id])
  mentee    MenteeProfile @relation(fields: [menteeId], references: [id])

  @@index([mentorId]) // Indexing mentorId for faster lookups 
  @@index([menteeId]) // Indexing menteeId for faster lookups 
}

// New Availability model to store mentor availability details
model Availability {
  id        Int       @id @default(autoincrement())
  mentorId  Int       // Foreign key to MentorProfile
  dayOfWeek DayOfWeek // Enum for days of the week
  startTime DateTime  @db.Timestamptz // Store as UTC timestamp
  endTime   DateTime  @db.Timestamptz // Store as UTC timestamp
  enabled   Boolean   @default(true)  // Added enabled field

  mentor    MentorProfile @relation(fields: [mentorId], references: [id])
}

// Enum for days of the week
enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELED
}
